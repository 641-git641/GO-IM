# Multi-stage build for IM Logic Service.
# Build:   docker build -f Dockerfile.logic -t im-logic .
# Run:     docker run -p 50051:50051 -v $(pwd)/configs:/etc/im im-logic

FROM golang:1.26.5-alpine AS builder

WORKDIR /app

# Accept proxy settings from build args (for VPN/accelerator users).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Use Go proxy mirror (goproxy.cn) as primary; direct fallback if VPN is active.
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.org

# Cache dependencies.
COPY go.mod go.sum ./
RUN go mod download

# Build the binary.
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o logic ./cmd/logic/

# Minimal runtime image.
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/logic /usr/local/bin/logic

EXPOSE 50051

ENV CONFIG_PATH=/etc/im/config.json

CMD ["logic"]
