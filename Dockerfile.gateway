# Multi-stage build for IM Gateway.
# Build:   docker build -f Dockerfile.gateway -t im-gateway .
# Run:     docker run -p 8080:8080 -v $(pwd)/configs:/etc/im im-gateway

FROM golang:1.26.5-alpine AS builder

WORKDIR /app

# Accept proxy settings from build args (for VPN/accelerator users).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Use Go proxy mirror (goproxy.cn) as primary; direct fallback if VPN is active.
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.org

# Cache dependencies.
COPY go.mod go.sum ./
RUN go mod download

# Build the binary.
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o gateway ./cmd/gateway/

# Minimal runtime image.
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/gateway /usr/local/bin/gateway

EXPOSE 8080 8081

ENV CONFIG_PATH=/etc/im/config.json

CMD ["gateway"]
