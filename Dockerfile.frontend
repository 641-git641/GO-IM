# IM 前端多阶段构建。
# 阶段 1: Node —— 安装依赖并构建 Vite React 应用。
# 阶段 2: nginx —— 提供静态资源服务，并将 API 请求反向代理到 Gateway。
#
# Build:   docker build -f Dockerfile.frontend -t im-frontend .
# Run:     docker run -p 80:80 im-frontend

# ---------------------------------------------------------------------------
# 阶段 1 —— 构建
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# 从构建参数接受代理设置（供 VPN/加速器用户使用）。
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# 缓存依赖。
COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts

# 构建生产环境产物。
COPY web/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# 阶段 2 —— 提供服务
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

# 用我们的反向代理 + SPA 配置替换默认 nginx 配置。
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# 移除默认 nginx 内容并拷贝构建好的前端产物。
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist/ /usr/share/nginx/html/

EXPOSE 80
