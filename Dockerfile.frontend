# Multi-stage build for IM Frontend.
# Stage 1: Node — install deps + build the Vite React app.
# Stage 2: nginx — serve static assets + reverse proxy API calls to Gateway.
#
# Build:   docker build -f Dockerfile.frontend -t im-frontend .
# Run:     docker run -p 80:80 im-frontend

# ---------------------------------------------------------------------------
# Stage 1 — Build
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Accept proxy settings from build args (for VPN/accelerator users).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Cache dependencies.
COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts

# Build the production bundle.
COPY web/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2 — Serve
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Replace default nginx config with our reverse proxy + SPA config.
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx content and copy the built frontend.
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist/ /usr/share/nginx/html/

EXPOSE 80
