{
    "_comment": "IM Gateway config example. Copy to config.json and modify.",
    "_docker_comment": "When running inside Docker Compose, use Docker DNS names: redis→redis:6379, mysql→mysql:3306, kafka→kafka:9092, minio→minio:9000, logic→logic:50051",

    "gateway": {
        "http_addr": ":8080",
        "tcp_addr": ":8081",
        "transport": "websocket",
        "heartbeat": "30s",
        "heartbeat_fail": 3,
        "check_origin": ["http://localhost:3000", "http://localhost:5173"],

        "conn": {
            "pong_wait": "60s",
            "ping_period": "54s",
            "max_msg_size": 65536,
            "send_buf_size": 256,
            "offline_max_size": 1000
        },

        "rate_limit": {
            "enabled": true,
            "rate": 10,
            "burst": 20,
            "cleanup_interval": "5m"
        },

        "redis": {
            "addr": "localhost:6379",
            "password": "",
            "db": 0
        },

        "gnet": {
            "num_event_loops": 0,
            "worker_pool_size": 0
        },

        "mysql": {
            "enabled": false,
            "dsn": "im:im-dev@tcp(127.0.0.1:3307)/im?parseTime=true&charset=utf8mb4"
        },

        "auth": {
            "dev_mode": true
        },

        "kafka": {
            "enabled": false,
            "brokers": ["localhost:9092"],
            "topic": "im.message.persist"
        },

        "logic": {
            "addr": "",
            "listen_addr": ""
        },

        "grpc": {
            "_comment": "Multi-gateway mode: set addr (this Gateway's gRPC listen port), node_id, and peer_addrs. Leave addr empty for single-node mode.",
            "addr": "",
            "node_id": "",
            "peer_addrs": {},
            "forward_dial_timeout": "3s",
            "forward_rpc_timeout": "2s",
            "discovery": {
                "_comment": "Service discovery mode: 'static' (default, uses peer_addrs) or 'redis' (Redis-based auto-discovery with TTL heartbeat).",
                "mode": "static",
                "redis_key": "im:gateway:node:",
                "ttl": "15s",
                "health_interval": "5s"
            }
        },

        "object_storage": {
            "_comment": "MinIO/S3 object storage for file/image messages. enabled=false uses in-memory fallback.",
            "enabled": false,
            "endpoint": "localhost:9000",
            "access_key": "minioadmin",
            "secret_key": "minioadmin",
            "bucket": "im-files",
            "use_ssl": false,
            "max_upload": 10485760
        },

        "_tunables_comment": "Operational tunables — previously hardcoded, now configurable. Remove to use defaults.",
        "recall_window_ms": 120000,
        "history_default_limit": 30,
        "search_default_limit": 20,
        "dedup_ttl": "5m",
        "persist_concurrency": 64
    },

    "logic": {
        "_comment": "Logic service gRPC endpoint (used by Gateway) and server settings.",
        "addr": "",
        "listen_addr": "",
        "worker_id": 2,
        "mysql": { "enabled": false },
        "kafka": { "enabled": false }
    },

    "stability": {
        "_comment": "Operational stability settings.",
        "max_connections": 0,
        "http_read_timeout": "10s",
        "http_write_timeout": "10s",
        "http_idle_timeout": "120s",
        "shutdown_timeout": "30s",
        "pprof_enabled": false,
        "pprof_addr": "localhost:6060"
    },

    "jwt": {
        "secret": "change-me-in-production",
        "expiration": "168h"
    },

    "snowflake": {
        "worker_id": 1
    }
}
